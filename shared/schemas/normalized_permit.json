{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DepoiiNormalizedPermit",
  "description": "Shared canonical schema contract between Depoii FastAPI Engine and Next.js Frontend",
  "type": "object",
  "required": [
    "id",
    "sourceSystem",
    "rawPermitNumber",
    "jurisdiction",
    "state",
    "issueDate",
    "status",
    "normalizedAddress",
    "city",
    "zipCode",
    "valuation",
    "valuationFormatted",
    "category",
    "rawDescription",
    "probableRoofSystem",
    "contractorName",
    "isHailStormWindow",
    "isCompetitorCapture",
    "confidenceScore",
    "normalizedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "sourceSystem": {
      "type": "string",
      "enum": ["socrata", "accela", "energov", "cad", "shovels"]
    },
    "rawPermitNumber": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "state": { "type": "string" },
    "county": { "type": "string" },
    "issueDate": { "type": "string", "format": "date" },
    "appliedDate": { "type": "string", "format": "date" },
    "expirationDate": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["Issued", "Active", "Finaled", "Under Review", "Expired", "Unknown"]
    },
    "normalizedAddress": { "type": "string" },
    "city": { "type": "string" },
    "zipCode": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "parcelId": { "type": "string" },
    "valuation": { "type": "number" },
    "valuationFormatted": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "Commercial Re-Roof",
        "Roof Tear-Off & Replace",
        "Commercial Waterproofing & Coating",
        "Roof Repair & Alteration",
        "New Construction Commercial Roofing",
        "General Commercial Permit"
      ]
    },
    "rawDescription": { "type": "string" },
    "squareFootage": { "type": "integer" },
    "probableRoofSystem": {
      "type": "string",
      "enum": [
        "TPO Single-Ply",
        "EPDM Membrane",
        "PVC Single-Ply",
        "Modified Bitumen / BUR",
        "Metal Standing Seam",
        "Elastomeric Restoration / Coating",
        "Commercial Tile / Shingle",
        "Unspecified Commercial System"
      ]
    },
    "contractorName": { "type": "string" },
    "contractorLicense": { "type": "string" },
    "contractorPhone": { "type": "string" },
    "isHailStormWindow": { "type": "boolean" },
    "associatedStormEvent": { "type": "string" },
    "isCompetitorCapture": { "type": "boolean" },
    "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "normalizedAt": { "type": "string" }
  }
}
