# Depoii Data Engine Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True
API_KEY=depoii-secret-dev-key-2026

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://depoii_user:depoii_password@localhost:5432/depoii_warehouse
SYNC_DATABASE_URL=postgresql://depoii_user:depoii_password@localhost:5432/depoii_warehouse

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External Feeds
SOCRATA_APP_TOKEN=
NOAA_SPC_API_ENDPOINT=https://www.spc.noaa.gov/climo/reports/today.csv

# Observability
SLACK_ALERT_WEBHOOK=
LOG_LEVEL=INFO
